# Copier ce fichier en .env et renseigner les valeurs (ne jamais committer .env).

# Base de développement
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/doztra_dev?schema=public"

# Base de test, distincte : vidée et réinitialisée par les tests d’intégration et e2e
DATABASE_URL_TEST="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/doztra_test?schema=public"

# Authentification (Better Auth)
# Clé de signature des sessions, 32 caractères aléatoires minimum :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL publique de l’application (https en déploiement)
BETTER_AUTH_URL="http://localhost:3000"
