generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Une demande client. Immuable après création, sauf is_priority.
model CustomerRequest {
  /// UUID de soumission fourni par l’application (idempotence) : pas de valeur par défaut.
  id            String   @id @db.Uuid
  customerName  String   @map("customer_name") @db.VarChar(150)
  customerEmail String?  @map("customer_email") @db.VarChar(254)
  customerPhone String?  @map("customer_phone") @db.VarChar(30)
  subject       String   @db.VarChar(200)
  description   String   @db.Text
  isPriority    Boolean  @default(false) @map("is_priority")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Écrit explicitement, seulement sur changement réel (pas de @updatedAt).
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([isPriority(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "idx_requests_list")
  @@map("customer_requests")
}

// ─── Authentification (Better Auth + plugin admin) ──────────────────────────
// Comptes créés par un administrateur uniquement : aucune inscription publique.

/// Collaborateur Doztra. role : « admin » ou « agent » (CHECK en base).
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          String    @default("agent")
  /// Compte désactivé par un administrateur : aucune connexion possible.
  banned        Boolean   @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  apiSessions   ApiSession[]

  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Identifiants de connexion ; providerId « credential » = e-mail + mot de passe haché.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ─── API mobile ─────────────────────────────────────────────────────────────

/// Session de l’app mobile, une par appareil connecté. Jetons opaques : seul leur SHA-256
/// est stocké. Accès court (15 min) ; rafraîchissement à usage unique avec rotation.
model ApiSession {
  id                  String    @id @db.Uuid
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash     String    @unique @map("access_token_hash")
  accessExpiresAt     DateTime  @map("access_expires_at") @db.Timestamptz(3)
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  /// Jeton de rafraîchissement précédent : sa réutilisation signale un vol → session révoquée.
  previousRefreshHash String?   @unique @map("previous_refresh_hash")
  refreshExpiresAt    DateTime  @map("refresh_expires_at") @db.Timestamptz(3)
  deviceName          String?   @map("device_name") @db.VarChar(100)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt          DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("api_sessions")
}
